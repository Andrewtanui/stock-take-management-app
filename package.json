{
  "name": "ibky-stock-management",
  "version": "0.1.0",
  "description": "IBKY Stock Management code app (UI demo)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "vite build --mode preview",
    "typecheck": "tsc -b",
    "dv:schema": "node scripts/dataverse/create-schema.mjs",
    "dv:schema:dry": "node scripts/dataverse/create-schema.mjs --dry-run",
    "dv:roles": "node scripts/dataverse/create-roles.mjs",
    "check:shared": "node scripts/check-shared.mjs",
    "dv:seed": "node scripts/dataverse/seed.mjs",
    "dev:dv": "vite --mode dataverse",
    "build:dv": "tsc -b && vite build --mode dataverse",
    "dv:flows": "node scripts/dataverse/create-flows.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@microsoft/power-apps": "^1.5.0",
    "lucide-react": "^1.52.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.12"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@azure/msal-node": "^7.0.1",
    "@microsoft/power-apps-cli": "1.2.0",
    "@microsoft/power-apps-vite": "^1.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.63.0",
    "typescript": "5.6",
    "vite": "^6.4.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "allowScripts": {
    "keytar@7.9.0": true
  }
}
